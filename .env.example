# Conexão ao cluster PostgreSQL gerenciado pelo pgtui.
#
# O database presente na URL é o "admin db": é onde rodam as consultas de
# nível de cluster (pg_stat_activity, pg_database, replicação, locks). O TUI
# abre conexões adicionais sob demanda ao navegar para as tabelas de outro
# banco ou ao rodar uma query com alvo diferente.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=disable

# Intervalo de auto-refresh do dashboard, em segundos (default 5).
PGTUI_REFRESH_SECONDS=5
