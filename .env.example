# Connection to the PostgreSQL cluster managed by pgtui.
#
# The database in the URL is the "admin db": it's where cluster-level queries
# run (pg_stat_activity, pg_database, replication, locks). The TUI opens
# additional connections on demand when navigating to another database's
# tables or running a query with a different target.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=disable

# Dashboard auto-refresh interval, in seconds (default 5).
PGTUI_REFRESH_SECONDS=5
